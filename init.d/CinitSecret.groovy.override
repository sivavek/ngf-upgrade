#!groovy

import jenkins.model.Jenkins
import hudson.util.Secret
import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.domains.Domain
import org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl

/**
 * Adds credentials to Jenkins with randomly generated secret values if they do not already exist.
 */

// Function to generate a random alphanumeric string
def generateRandomSecret(int length) {
    return new java.security.SecureRandom().with { r ->
        def pool = ('a'..'z') + ('A'..'Z') + (0..9)
        (1..length).collect { pool[r.nextInt(pool.size())] }.join('')
    }
}

// List of credentials to add
def creds = [
    [
        id: 'cisco-sbg-github-cloud-PAT',
        description: 'GitHub Cloud PAT',
        secret: generateRandomSecret(32)
    ],
    [
        id: 'cisco-sbg-github-cloud-wh-shared-secret',
        description: 'GitHub Webhook Shared Secret',
        secret: generateRandomSecret(32)
    ]
]

// Get Jenkins instance
def jenkins = Jenkins.getInstanceOrNull()
println "Jenkins instance: ${jenkins}"
if (jenkins == null) {
    println 'Jenkins instance is not available.'
    return
}

// Get the credentials domain and store
def domain = Domain.global()
println "Domain: ${domain}"
if (domain == null) {
    println 'Global domain is null. Ensure the domain is correctly configured.'
    return
}

def store = jenkins.getExtensionList('com.cloudbees.plugins.credentials.SystemCredentialsProvider')[0]?.getStore()
println "Credentials store: ${store}"
if (store == null) {
    println 'Credentials store is not available.'
    return
}

// Retrieve existing credentials and filter out nulls
def existingCreds = store.getCredentials(domain)?.findAll { it != null } ?: []

// Loop over each credential
creds.each { cred ->
    // Check if the credential with the same ID already exists
    def existingCred = existingCreds.find { it?.id == cred.id }

    if (existingCred == null) {
        // If the credential doesn't exist, create it
        println "Creating credential with ID: ${cred.id}"

        def newCred = new StringCredentialsImpl(
            CredentialsScope.GLOBAL,
            cred.id,
            cred.description,
            Secret.fromString(cred.secret)
        )

        // Add the credential to the store
        store.addCredentials(domain, newCred)
    } else {
        println "Credential with ID: ${cred.id} already exists. Skipping creation."
    }
}

// Save the Jenkins configuration
try {
    jenkins.save()
} catch (Exception e) {
    println "Failed to save credentials: ${e.message}"
}

